<component type="desktop-application">
  <id>com.luduvo.Luduvo</id>
  <name>Luduvo</name>
  <summary>Create and play user-made worlds</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <description>
    <p>
      Luduvo is a platform for building and playing user-created
      games.  Luduvo Studio is the editor: model worlds, script
      behavior, and playtest locally.  The player joins multiplayer
      servers through luduvo:// links from the browser.
    </p>
  </description>
